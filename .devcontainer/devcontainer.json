{
  "name": "Electrolux Business Growth Hackathon",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "ms-python.python"
      ],
      "settings": {
        "chat.disableAIFeatures": true
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/cline-defaults.sh; command -v gcloud >/dev/null && command -v pdftotext >/dev/null || bash .devcontainer/setup.sh",
  "containerEnv": {
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "CLOUDSDK_COMPUTE_REGION": "europe-north1"
  }
}
